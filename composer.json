{
    "name": "nytodev/inertia-bundle",
    "description": "Symfony Bundle implementing the Inertia.js v2 server-side protocol",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Tony Blard",
            "email": "tonyblard55@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.65",
        "symfony/test-pack": "^1.1",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nytodev\\InertiaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nytodev\\InertiaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4 || ^7.4 || ^8.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
