parameters:
    level: 8
    paths:
        - src

    phpVersion: 80100

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # DefinitionConfigurator became @template-annotated at different Symfony patch versions.
        # The generic parameter adds no runtime value here — suppress across all supported Symfony versions.
        - '#Method Nytodev\\InertiaBundle\\InertiaBundle::configure\(\) has parameter \$definition with generic class .* but does not specify its types#'
